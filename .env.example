# Optional: connect the Assistant to Claude through server/ai-proxy.
# Leave unset and the built-in, on-device assistant answers everything.
# On a phone, use your computer's LAN IP (not localhost), e.g. http://192.168.1.20:8787
EXPO_PUBLIC_AI_PROXY_URL=
# Must match APP_TOKEN in server/ai-proxy/.env. Not a secret (it ships in the app);
# it only stops casual use of your proxy URL.
EXPO_PUBLIC_AI_APP_TOKEN=

# Optional: turn on sign-in through server/auth.
# Leave unset and the app works signed out; the Account screen says accounts are off.
# On a phone, use your computer's LAN IP (not localhost), e.g. http://192.168.1.20:8788
EXPO_PUBLIC_AUTH_URL=
# Must match APP_TOKEN in server/auth/.env. Not a secret (it ships in the app).
EXPO_PUBLIC_AUTH_APP_TOKEN=

# Optional: a link (App Store / Play Store / landing page) added to partner invites.
# Leave unset and invites are sent as text only.
EXPO_PUBLIC_INVITE_URL=

# Optional: the public address of RSVP pages and wedding websites (the server's PUBLIC_BASE_URL),
# used for "Open the website". Without it the app reads it from an RSVP link.
EXPO_PUBLIC_SITE_URL=
