# Copy to .env and fill in. Never commit .env.
# Where accounts are stored. Back this file up - it is every user's login.
AUTH_DB_PATH=./data/auth.db
# Any long random string. Put the same value in the app's EXPO_PUBLIC_AUTH_APP_TOKEN.
APP_TOKEN=change-me-to-a-long-random-string
PORT=8788
# Where invite links point; the token is appended. Default is the app's own link,
# weddinggpt://invite/. Use a web page here once one can redirect into the app.
INVITE_URL_BASE=weddinggpt://invite/
