# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Any long random string. Put the same value in the app's EXPO_PUBLIC_AI_APP_TOKEN.
APP_TOKEN=change-me-to-a-long-random-string
# low | medium | high. Medium balances answer quality and chat speed.
AI_EFFORT=medium
PORT=8787
