{
  "name": "weddinggpt",
  "version": "0.1.0",
  "description": "WeddingGPT - an AI wedding-planning companion for iOS and Android: checklist, budget, guest list and a planning assistant, built with Expo and React Native.",
  "keywords": [
    "wedding",
    "wedding-planner",
    "expo",
    "react-native",
    "ai-assistant",
    "budget",
    "guest-list",
    "mobile-app"
  ],
  "homepage": "https://github.com/selveapps/WeddingGPT#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selveapps/WeddingGPT.git"
  },
  "bugs": {
    "url": "https://github.com/selveapps/WeddingGPT/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Selve Apps",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "icons": "node scripts/build-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{js,jsx}\" \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"app/**/*.{js,jsx}\" \"src/**/*.{js,jsx}\"",
    "test": "jest",
    "build": "expo export"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-calendar": "~57.0.6",
    "expo-constants": "~57.0.19",
    "expo-contacts": "~57.0.8",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/server/",
      "<rootDir>/WeddingGPT/"
    ]
  }
}
